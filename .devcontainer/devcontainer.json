{
  "name": "banking",
  // The whole stack from the root docker-compose.yml (Postgres, RabbitMQ, Swagger UI, ledger,
  // accounts), with compose.yaml turning the two services into dev mode and adding the
  // workspace container, which the editor attaches to.
  "dockerComposeFile": ["../docker-compose.yml", "compose.yaml"],
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  // The services fetch their own deps (`mix setup`); only the e2e app is left.
  "postCreateCommand": "cd apps/e2e && mix deps.get",
  "customizations": {
    "vscode": {
      "extensions": [
        "JakeBecker.elixir-ls",
        "phoenixframework.phoenix",
        "redhat.vscode-yaml",
        "bierner.markdown-mermaid"
      ]
    }
  }
}
